---
interface Props {
  current: number;
  total: number;
  /** 列表根路径，形如 /sharker-blog/notes/ */
  basePath: string;
}

const { current, total, basePath } = Astro.props;

const href = (p: number) => (p <= 1 ? basePath : `${basePath}page/${p}/`);

// 页码窗口：始终显示首尾页，当前页左右各留一页，中间用省略号。
function pageItems(): (number | '...')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const out: (number | '...')[] = [1];
  const from = Math.max(2, current - 1);
  const to = Math.min(total - 1, current + 1);
  if (from > 2) out.push('...');
  for (let p = from; p <= to; p++) out.push(p);
  if (to < total - 1) out.push('...');
  out.push(total);
  return out;
}

const pages = pageItems();
---

{
  total > 1 && (
    <nav class="pager" aria-label="分页">
      {current > 1 ? (
        <a class="pg pg-step" href={href(current - 1)} rel="prev">
          ← 上一页
        </a>
      ) : (
        <span class="pg pg-step is-off">← 上一页</span>
      )}

      <span class="pg-nums">
        {pages.map((p) =>
          p === '...' ? (
            <span class="pg-gap">…</span>
          ) : p === current ? (
            <span class="pg pg-num is-current" aria-current="page">
              {p}
            </span>
          ) : (
            <a class="pg pg-num" href={href(p)}>
              {p}
            </a>
          ),
        )}
      </span>

      {current < total ? (
        <a class="pg pg-step" href={href(current + 1)} rel="next">
          下一页 →
        </a>
      ) : (
        <span class="pg pg-step is-off">下一页 →</span>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 26px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 11.5px;
  }

  .pg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 7px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: #fbfaf5;
    color: var(--ink-soft);
  }

  .pg:hover {
    border-color: #c9c5b6;
    color: var(--accent);
    text-decoration: none;
  }

  .pg.is-off {
    color: #c8c6bd;
    border-color: #eeece4;
    background: none;
  }

  .pg.is-current {
    border-color: #b9b4a3;
    background: var(--shell);
    color: var(--ink);
  }

  .pg-nums {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pg-gap {
    color: var(--ink-faint);
    padding: 0 1px;
  }

  @media (max-width: 520px) {
    .pg-step {
      padding: 0 6px;
      font-size: 11px;
    }

    .pg-nums {
      gap: 3px;
    }
  }
</style>
